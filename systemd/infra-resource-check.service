[Unit]
Description=Read-only infrastructure resource check
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/infra-toolkit/resource-report.sh
Environment=DISK_THRESHOLD=85
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
